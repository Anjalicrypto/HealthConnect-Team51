<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_New_Care_Plan_Details</name>
        <label>Set New Care Plan Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>New_Care_Plan.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Care_Plan_Name_Text</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>New_Care_Plan.Patient__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Related_Health_Assessment.Patient__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>New_Care_Plan.Doctor_Review__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>New_Care_Plan.Care_Plan_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>New_Care_Plan.Follow_up_Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Followup_Due_Date_7_Days</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Care_Plan</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Care_Plan_Exists</name>
        <label>Check Care Plan Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Existing_Care_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Care_Plan.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_New_Care_Plan_Details</targetReference>
            </connector>
            <label>No Existing Care Plan</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Patient_Exists</name>
        <label>Check Patient ExistsS</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Patient_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Health_Assessment.Patient__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Care_Plan</targetReference>
            </connector>
            <label>Patient Found</label>
        </rules>
    </decisions>
    <description>Automatically creates a follow-up Care Plan when a Doctor Review requires follow-up.</description>
    <environments>Default</environments>
    <formulas>
        <name>Followup_Due_Date_7_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Review_Date__c} + 7</expression>
    </formulas>
    <interviewLabel>Doctor Review - Auto Create Care Plan {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Doctor Review - Auto Create Care Plan</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Care_Plan</name>
        <label>Create Care Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>New_Care_Plan</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Care_Plan</name>
        <label>Get Existing Care Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Care_Plan_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Doctor_Review__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Care_Plan__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Health_Assessment</name>
        <label>Get Related Health Assessment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Patient_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Health_Assessment__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Health_Assessment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Health_Assessment</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Follow_up_Required__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Doctor_Review__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Care_Plan_Name_Text</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Follow-up - Doctor Review</text>
    </textTemplates>
    <variables>
        <name>New_Care_Plan</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Care_Plan__c</objectType>
    </variables>
</Flow>
